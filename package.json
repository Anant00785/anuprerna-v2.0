{
  "name": "anuprerna",
  "private": true,
  "packageManager": "pnpm@9.12.0+sha512.4abf725084d7bcbafbd728bfc7bee61f2f791f977fd87542b3579dcb23504d170d46337945e4c66485cd12d588a0c0e570ed9c477e7ccdd8507cf05f3f92eaca",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "docs:gen": "node scripts/gen-docs/index.mjs",
    "docs:check": "node scripts/gen-docs/index.mjs --check",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "test:int": "turbo run test:int",
    "typecheck": "turbo run typecheck",
    "swagger:share": "node scripts/swagger-share.mjs",
    "swagger:export": "node scripts/export-swagger.mjs",
    "swagger:export:prod": "node scripts/export-swagger.mjs --host=api.anuprerna.com",
    "swagger:docs": "open apps/api/SWAGGER.md || xdg-open apps/api/SWAGGER.md",
    "tunnel:share": "node scripts/cloudflare-share.mjs",
    "tunnel:info": "echo 'Cloudflare Tunnel URLs:' && node scripts/cloudflare-share.mjs"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  }
}
