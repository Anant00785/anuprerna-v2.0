# apps/api/.env.example
#
# Every env var the API's schema (src/common/config/env.schema.ts) knows
# about. Copy to .env and fill in real values, or generate .env from the
# workspace Spring secrets file with:
#   node scripts/env-from-spring.mjs
#
# Only DATABASE_URL and AUTH_JWT_SECRET are required to boot — everything
# else is optional; the API boots without it, and only the specific
# integration that needs it fails when invoked.

# --- Boot-critical ---------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/anuprerna
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# --- App runtime ------------------------------------------------------------
NODE_ENV=development
PORT=3000
SWAGGER=true

# --- Auth (pepper is read starting Phase 1; TTL/secret already in use) -----
AUTH_PASSWORD_PEPPER=
AUTH_JWT_TTL_SECONDS=86400

# --- Kill-switches — the anti-spam / anti-live-money layer. Leave false. ---
OUTBOUND_EMAIL_ENABLED=false
OUTBOUND_SMS_ENABLED=false
OUTBOUND_WHATSAPP_ENABLED=false
PAYMENTS_LIVE_MODE=false

# --- AWS S3 ------------------------------------------------------------------
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
# Legacy fallback names also read by image.service.ts:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=

# --- SMTP (email) -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Payments (guard only this phase — no provider calls implemented) -----
# Test-mode keys only unless PAYMENTS_LIVE_MODE=true and NODE_ENV=production.
STRIPE_KEY_SECRET=sk_test_00000000000000000000000000000000000000000000
STRIPE_WEBHOOK_SECRET=whsec_0000000000000000000000000000000000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- MSG91 (OTP SMS) -----------------------------------------------------------
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_LENGTH=4
# Legacy names read directly by msg91.service.ts today:
MSG91_TEMPLATE_ID=
MSG91_SEND_OTP_URL=
MSG91_VERIFY_OTP_URL=
MSG91_RESEND_OTP_URL=
MSG91_FAKE_MODE=false

# --- WhatsApp (Freshchat) -------------------------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_NAMESPACE=
WHATSAPP_MOBILE=
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=

# --- Zoho -----------------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_OAUTH_BASE_URI=
ZOHO_API_BASE_URI=
# Legacy name read directly by zoho.service.ts today:
ZOHO_API_BASE_URL=

# --- AI / misc (Phase 5, droppable) ---------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMAIL_ENCRYPTION_KEY=
