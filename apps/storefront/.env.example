NEXT_PUBLIC_API_URL=http://localhost:8090

# Legacy backend's table-explorer access token, injected by the /api/backend
# proxy route. Server-side only — must NOT be prefixed NEXT_PUBLIC_, which
# would inline it into the client bundle. Ask the team for the value; it is
# deliberately not committed. See docs/KNOWN-GAPS.md.
LOOM_TABLE_EXPLORER_TOKEN=

# Social login is brokered through Auth0 — Loom's /authenticate/social validates
# an Auth0 ID token, so a raw Google token can never work. Public SPA identifiers,
# not secrets; src/env.ts defaults to the same tenant the legacy storefront uses.
# The origin you serve the storefront from (e.g. http://localhost:4200) must be in
# the Auth0 application's Allowed Web Origins / Allowed Callback URLs.
NEXT_PUBLIC_AUTH0_DOMAIN=dev-cxnfeuu6gvepp7qu.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=iW2PThISjeDP6I1dGoTgsoWDGwneBXPP
