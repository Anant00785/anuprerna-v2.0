# ==============================================================================
# ANUPRERNA STOREFRONT (.env.local / .env)
# ==============================================================================

# Backend API Configuration
NEXT_PUBLIC_API_MODE=nest
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_NEST_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SPRINGBOOT_API_URL=http://127.0.0.1:3000

# Table Explorer & Auth
LOOM_TABLE_EXPLORER_TOKEN=local-dev-token

# Payment Gateways (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_TPvtsOM52j6QKA
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51S3WzdSRioYtxltc2tRZZ1GG4SKTJ04W7xwwEUqay0NHGzywN5nTgPdy8oR91QRHDWT0JXIFb04CHm3yyZvU0sTu00ddfP9480

# Gmail SMTP for Live OTP Delivery (Email Verification)
# To generate SMTP_PASS: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_USER=
SMTP_PASS=

# Signing key for passwordless (email-code) sessions. Required — no default.
AUTH_JWT_SECRET=

# Neon Postgres + S3-compatible object storage for the feedback widget.
# Required — no default. See docs/KNOWN-GAPS.md for the incident this replaced.
DATABASE_URL=
NEON_S3_ENDPOINT=
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
NEON_S3_REGION=us-east-2
# Real bucket name is "feeback" (misspelled in the Neon project's own config,
# see /neon.ts at the repo root) — do not "fix" this to "feedback".
NEON_FEEDBACK_BUCKET=feeback

# Backend the storefront BFF (lib/loom/client) talks to.
# Point this at OUR OWN API (apps/api, default port 3000). Its
# loom-legacy-auth + cart controllers serve the same paths legacy Loom did
# (/authenticate/email, /add/cart-item, /get/cart-item/list, ...), so nothing
# else has to change. Without it the BFF falls back to the hardcoded remote
# Loom in lib/loom/config.ts, which rejects locally-issued sessions.
LOOM_BASE_URL=http://127.0.0.1:3000
