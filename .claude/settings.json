{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/gen-docs/hook.mjs\"",
            "timeout": 90,
            "async": true,
            "statusMessage": "Reconciling docs"
          }
        ]
      }
    ]
  }
}
